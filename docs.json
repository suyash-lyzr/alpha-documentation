{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Alpha",
  "colors": {
    "primary": "#1A54F0",
    "light": "#749FF9",
    "dark": "#1A54F0"
  },
  "background": {
    "color": {
      "light": "#FAFAF9",
      "dark": "#0E0E0D"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Geist",
    "heading": {
      "family": "Geist",
      "weight": 600
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "favicon": "/images/favicon.png",
  "logo": {
    "light": "/images/logo/light.png",
    "dark": "/images/logo/dark.png",
    "href": "https://alpha.new"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open Alpha",
      "href": "https://alpha.new"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get started",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "get-started/how-alpha-works",
              "get-started/prompting",
              "get-started/choose-the-right-tool"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/landing-page",
              "guides/data-app",
              "guides/existing-repo",
              "guides/ai-agent",
              "guides/weekly-summary"
            ]
